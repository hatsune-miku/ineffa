{
  "name": "ineffa-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "bun run src/main.ts",
    "build": "vite build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,json,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,cjs,json,css,html}\"",
    "typecheck": "tsc --noEmit",
    "test": "bun run scripts/test.ts",
    "test:ui": "bun run scripts/ui-fixture.ts",
    "docker:pack": "bun run scripts/docker-pack.ts",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@a1knla/cakeui": "0.2.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@opencode/sdk": "2.0.3",
    "ineffa": "workspace:*",
    "ineffa-kook": "workspace:*",
    "jsonc-parser": "3.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/bun": "1.3.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
